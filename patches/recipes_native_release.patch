+        if ld_enabled:
+            global_sync_all()
+            # 显式 UB 视图复用已排空的阶段空间，不重置 Channel 编译期资源。
+            if candidate_enabled:
+                CandidateLdMergeStage(topk, split_count, candidate_optimized=True)(
+                    sparse_indices,
+                    sparse_value_bits,
+                    final_sparse_indices,
+                    final_sparse_bits,
+                    metadata,
+                    total_q,
+                    worker_count * 2,
+                    cu_seqlens_q,
+                    query_tile_rows,
+                    has_cu_seqlens_q,
+                    output_offset_address,
