+                    key_out,
+                    candidate_key_out,
+                    public_row_base,
+                    task_span_count,
+                    task_active_count,
+                    workspace_task_idx,
+                    logical_start,
+                    actual_s2,
+                    query_offset,
+                    used_q,
+                    cmp_residual,
+                    candidate_tokens,
+                    candidate_length,
+                    logical_start - tile_begin * TILE_N,
