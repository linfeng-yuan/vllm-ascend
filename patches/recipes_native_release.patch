+                    mask=mask32,
+                )
+                valid16 = rr.vlts(
+                    rr.varange(chunk * 64, dtypes.uint16),
+                    output_valid_count,
+                    mask=mask16,
+                )
+                indices = rr.vselect(
+                    rr.vadds(
+                        rr.vreinterpret(pos32, dtypes.int32),
