+            query_address,
+            key_address,
+            weights,
+            query_scale,
+            key_scale_address,
+            key_stride0,
+            key_dequant_scale_stride0,
+            cu_seqlens_q,
+            seqused_q,
+            seqused_k,
+            cmp_residual_k,
+            block_table,
+            key_out,
+            candidate_key_out,
+            sparse_indices_address,
+            sparse_value_bits_address,
+            candidate_indices_address,
+            candidate_value_bits_address,
+            candidate_length,
+            worker_count,
+            total_q,
+            batch_count,
+            tokens,
+            max_tasks_per_batch,
+            key_rows,
+            scale_rows,
+            metadata,
+            task_count,
+            final_sparse_indices_address,
+            final_sparse_bits_address,
+            final_candidate_indices_address,
+            final_candidate_bits_address,
+            return_values,
+            merge_workers,
+            output_offset_address,
