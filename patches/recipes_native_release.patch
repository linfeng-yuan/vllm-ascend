+    @host
+    def run_fused_cv(
+        query_address,
+        key_address,
+        weights: Tensor,
+        query_scale,
+        key_scale_address,
+        key_stride0,
+        key_dequant_scale_stride0,
+        cu_seqlens_q: Tensor,
+        seqused_q: Tensor,
+        seqused_k: Tensor,
