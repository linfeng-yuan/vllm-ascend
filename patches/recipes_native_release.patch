+    ChannelKind,
+    Dim,
+    MemLoc,
+    Tensor,
+    TensorSpec,
+    compile as dsl_compile,
+    const_expr,
+    dtypes,
+    host,
+    get_block_idx,
+    get_block_num,
+    get_subblock_dim,
+    get_subblock_id,
+    jit,
+    kernel,
+    cv_valid_extent,
+    make_copy_engine as _dsl_make_copy_engine,
+    matmul,
+    mem_copy,
+    range_constexpr,
+    vf,
+)
+
+from cannbotdsl.aot import export
+from cannbotdsl.ops.reg import (
+    PackMode,
+    create_mask,
+    full_mask,
+    varange,
+    vabs,
+    vadd,
+    vadds,
