+            candidate_enabled,
+            candidate_topk,
+            mask_mode,
+            cmp_ratio,
+            has_cu_seqlens_q,
+            has_seqused_q,
+            has_seqused_k,
+            has_block_table,
+            pa_block_size,
+            query_head_count,
