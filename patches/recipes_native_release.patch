+                    sparse_indices,
+                    sparse_value_bits,
+                    final_sparse_indices,
+                    final_sparse_bits,
+                    metadata,
+                    total_q,
+                    worker_count * 2,
+                    cu_seqlens_q,
+                    query_tile_rows,
+                    has_cu_seqlens_q,
+                    output_offset_address,
+                    return_values,
