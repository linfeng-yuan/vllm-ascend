+# T-only schedule is kept, so the 75% MFU path is unchanged.
+# IPQW_HEAD_SPLIT=0 restores the old 1-core-per-T-tile launch for A/B.
+HEAD_SPLIT = int(os.environ.get("IPQW_HEAD_SPLIT", 1))
