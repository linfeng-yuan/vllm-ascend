+class LdMergeStage:
+    def __init__(self, topk, splits):
+        self.topk = topk
+        self.length = topk * splits
+        self.workspace = QsliMergeTopKWorkspace(TOPK_TRUNK_LEN, topk)
+        self.selector = LdTopKSelector(topk, self.workspace, splits)
+
+    @jit
+    def __call__(
+        self,
+        partial_indices: Tensor,
+        partial_bits: Tensor,
+        indices: Tensor,
+        bits: Tensor,
+        metadata: Tensor,
+        rows,
+        workers,
+        cu_seqlens_q: Tensor,
+        query_tile_rows,
+        has_cu,
+        output_offset_address=0,
+    ):
+        ld_record_idx = dtypes.int64(
+            LD_RECORD_START + get_block_idx() * 2 + get_subblock_id()
+        )
+        if metadata[ld_record_idx, 0] != 0:
+            batch_idx = dtypes.int64(metadata[ld_record_idx, 1])
+            query_begin = dtypes.int64(0)
+            if has_cu:
+                query_begin = dtypes.int64(cu_seqlens_q[batch_idx])
+            row_base = (
+                query_begin + dtypes.int64(metadata[ld_record_idx, 2]) * query_tile_rows
+            )
+            workspace_begin = dtypes.int64(metadata[ld_record_idx, 3])
+            part_count = dtypes.int64(metadata[ld_record_idx, 4])
+            m_begin = dtypes.int64(metadata[ld_record_idx, 5])
+            m_end = m_begin + dtypes.int64(metadata[ld_record_idx, 6])
+            for m in dsl_range(m_begin, m_end, unroll=1):
+                row = row_base + m
+                output_offset = dtypes.int32(0)
+                if output_offset_address != 0:
+                    offsets = make_tensor(
+                        make_pointer(
+                            dtypes.int32, dtypes.int64(output_offset_address), MemLoc.GM
+                        ),
+                        make_layout((rows, 1), stride=(1, 1)),
+                    )
+                    output_offset = offsets[row, 0]
+                for first in dsl_range(
+                    0, part_count, self.length // self.topk - 1, unroll=1
+                ):
+                    count = min(part_count - first, self.length // self.topk - 1)
+                    carry = dtypes.int64((1 if first > 0 else 0))
+                    vec_sync_notify(PIPE.V, PIPE.MTE2, 5)
+                    vec_sync_wait(PIPE.V, PIPE.MTE2, 5)
+                    if first > 0:
+                        mem_copy(
+                            reinterpret(self.selector.ld_indices, shape=(1, self.topk)),
+                            tile_view(indices, (1, self.topk), (row, 0)),
+                        )
+                        mem_copy(
+                            reinterpret(self.selector.ld_bits, shape=(1, self.topk)),
+                            tile_view(bits, (1, self.topk), (row, 0)),
+                        )
+                    for part in dsl_range(0, count, unroll=1):
+                        source_row = (
+                            workspace_begin + first + part
+                        ) * query_tile_rows + m
+                        mem_copy(
+                            tile_view(
+                                self.selector.ld_indices,
+                                (1, self.topk),
+                                (0, part + carry),
+                            ),
+                            tile_view(partial_indices, (1, self.topk), (source_row, 0)),
+                        )
+                        mem_copy(
+                            tile_view(
+                                self.selector.ld_bits, (1, self.topk), (0, part + carry)
+                            ),
+                            tile_view(partial_bits, (1, self.topk), (source_row, 0)),
+                        )
+                    vec_sync_notify(PIPE.MTE2, PIPE.V, 5)
+                    vec_sync_wait(PIPE.MTE2, PIPE.V, 5)
+                    offset = dtypes.int32(
+                        (output_offset if first + count == part_count else 0)
+                    )
+                    self.selector.merge_ld(
+                        partial_indices,
+                        partial_bits,
+                        tile_view(indices, (1, self.topk), (row, 0)),
+                        tile_view(bits, (1, self.topk), (row, 0)),
+                        (count + carry) * self.topk,
+                        offset,
+                        True,
+                    )
+                    vec_sync_notify(PIPE.MTE3, PIPE.MTE2, 5)
+                    vec_sync_wait(PIPE.MTE3, PIPE.MTE2, 5)
+
