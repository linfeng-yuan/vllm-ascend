+    @jit
+    def _score_two_candidate(self, qk_handoff, group_count):
+        key_write = self.key_ub.produce()
+        with vf(mode="simd"):
+            mask16 = rr.update_mask(128, elem_bits=16)[0]
+            _weight_mask = rr.update_mask(self.n1, elem_bits=32)[0]
