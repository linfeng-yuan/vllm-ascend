+            addr=0,
+        )
+        self.qk_slot1 = _ub_buffer(
+            self.ub_pool,
+            MemLoc.UB,
+            (self.tile_m, 128),
+            dtypes.bfloat16,
+            stride=(256, 1),
+            addr=256,
+        )
