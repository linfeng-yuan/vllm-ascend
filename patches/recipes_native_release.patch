+        cube_sync_intra_wait(PIPE.FIXPIPE, 8)
+        cube_sync_intra_wait(PIPE.FIXPIPE, 24)
+        cube_sync_intra_wait(PIPE.FIXPIPE, 9)
+        cube_sync_intra_wait(PIPE.FIXPIPE, 25)
