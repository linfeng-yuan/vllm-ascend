+                CandidateLdMergeStage(
+                    candidate_topk, split_count, candidate_optimized=True
+                )(
+                    candidate_indices,
+                    candidate_value_bits,
+                    final_candidate_indices,
+                    final_candidate_bits,
+                    metadata,
+                    total_q,
+                    worker_count * 2,
+                    cu_seqlens_q,
+                    query_tile_rows,
+                    has_cu_seqlens_q,
+                )
