+def configure_aicpu_headers(target: str) -> list[str]:
+    """Bridge DSL 0.7.0's HCC 7.3 paths to the installed CANN toolchain.
+
+    This affects package compilation only. Installed metadata .so files do
+    not require a C++ compiler or CPLUS_INCLUDE_PATH at serving time.
+    """
+    from cannbotdsl.aicpu.toolchain import AicpuToolchain
+
+    toolchain = AicpuToolchain(npu_arch=target, launch_mode="interface")
+    base = Path(toolchain.toolkit) / "toolkit/toolchain/hcc/aarch64-target-linux-gnu/include/c++"
+    versions = [p for p in base.iterdir() if (p / "cstdint").is_file()]
+    if not versions:
+        raise RuntimeError(f"No CANN HCC C++ headers with cstdint under {base}")
+    def version_key(path):
+        return tuple(int(x) for x in path.name.split("."))
+    selected = max(versions, key=version_key)
+    include = [str(p) for p in (selected, selected / "aarch64-target-linux-gnu", selected / "backward") if p.is_dir()]
+    previous = os.environ.get("CPLUS_INCLUDE_PATH", "")
+    os.environ["CPLUS_INCLUDE_PATH"] = ":".join(dict.fromkeys(include + [p for p in previous.split(":") if p]))
+    print("AICPU CANN HCC headers: " + ":".join(include), flush=True)
+    return include
+
+
